import webcpp ;
webcpp.targets native wasip2 wasip3 ;
webcpp.original python3 : .. ;

webcpp.link cobalt_tls_client : cobalt_tls_client.cpp
    : <library>/webcpp/cobalt//cobalt <library>/webcpp/asio//tls <exception-handling>off:<source>/webcpp//throw_exception ;
explicit cobalt_tls_client ;

webcpp.link cobalt_ssl_client : cobalt_ssl_client.cpp
    : <library>/webcpp/cobalt//cobalt_ssl <exception-handling>off:<source>/webcpp//throw_exception ;
explicit cobalt_ssl_client ;

webcpp.link cobalt_ssl_state : cobalt_ssl_state.cpp
    : <library>/webcpp/cobalt//cobalt_ssl <include>../../../../tools/node-test/include
      <exception-handling>off:<source>/webcpp//throw_exception ;
explicit cobalt_ssl_state ;

webcpp.link cobalt_ssl_cancel : cobalt_ssl_cancel.cpp
    : <library>/webcpp/cobalt//cobalt_ssl <include>../../../../tools/node-test/include
      <exception-handling>off:<source>/webcpp//throw_exception ;
explicit cobalt_ssl_cancel ;

for local test in cobalt_tls_client cobalt_ssl_client cobalt_ssl_state cobalt_ssl_cancel
{
    local library = /webcpp/cobalt//cobalt_ssl ;
    local args = --embedded ;
    if $(test) = cobalt_tls_client
    { library = /webcpp/cobalt//cobalt /webcpp/asio//tls ; }
    if $(test) = cobalt_ssl_client { args += --require-sni ; }
    if $(test) in cobalt_ssl_state cobalt_ssl_cancel { args = --state-test ; }
    webcpp.drive $(test)_runtime : $(test).cpp
      : <library>$(library) <include>../../../../tools/node-test/include
        <webcpp-drive-timeout>180 <dependency>../../../../tools/openssl/test/tls.py
      : ../../../../tools/openssl/test/driver.py : $(args) : native wasip2 wasip3 ;
    .tls += $(test)_runtime ;
}
webcpp.lane tls : $(.tls) : native wasip2 wasip3 ;

# The recurring integration lane owns its Cobalt programs directly, so the
# report never attributes them to another library through compatibility aliases.
# MSVC's shared CRT forces threading=multi. S fixtures need its static CRT to
# configure and exercise the source-built no-threads provider.
local integration-tests ;
for local threading in single multi
{
    local runtime ;
    if $(threading) = single { runtime = <toolset>msvc:<runtime-link>static ; }
    for local exceptions in "on" "off"
    {
        local targets = native wasip3 ;
        if $(threading) = multi && $(exceptions) = "on" { targets = native ; }
        for local mode in cobalt state cancel
        {
            local source = cobalt_ssl_$(mode).cpp ;
            local args = --state-test ;
            if $(mode) = cobalt
            {
                source = cobalt_ssl_client.cpp ;
                args = --embedded --require-sni ;
            }
            local name = $(mode)-$(threading)-$(exceptions) ;
            webcpp.drive $(name) : $(source)
              : <library>/webcpp/cobalt//cobalt_ssl
                <include>../../../../tools/node-test/include
                <threading>$(threading) <exception-handling>$(exceptions)
                $(runtime) <webcpp-drive-timeout>180
                <dependency>../../../../tools/openssl/test/tls.py
              : ../../../../tools/openssl/test/driver.py : $(args) : $(targets) ;
            integration-tests += $(name) ;
        }
    }
}
webcpp.lane tls-integration : $(integration-tests) : native wasip3 ;

# Native core identity survives the explicitly owned SSL type in either include
# order.
webcpp.compile native_ssl_identity : native_identity.cpp
  : <library>/webcpp/cobalt//io_ssl : native ;
webcpp.compile native_ssl_identity_boost_first : native_identity.cpp
  : <library>/webcpp/cobalt//io_ssl <define>WEBCPP_TEST_BOOST_FIRST : native ;
