import webcpp ;
webcpp.targets emscripten ;
webcpp.original node : .. ;

# Exercise the module-owned cancellation registry, including rejected overlap
# and exception unwinding, before the page-driven examples use it.
webcpp.run browser_active_run : active_run_test.cpp
  : <library>/webcpp//node-test ;

# Reuse Asio's isolated browser host and exact-status driver. The Cobalt
# coroutine owns a real worker; Node success does not close this browser lane.
webcpp.drive browser_cobalt_worker : ../cobalt_thread_test.cpp
  : <threading>multi <webcpp-drive-timeout>60 <library>/webcpp/cobalt//cobalt
    <library>/webcpp//node-test <linkflags>-sPTHREAD_POOL_SIZE=1
  : ../../../asio/test/browser/run.mjs : --mode workers ;
webcpp.lane browser-workers : browser_cobalt_worker : emscripten ;

webcpp.drive browser_cobalt_worker_return : ../../../asio/test/browser/probes/pthread_return.cpp
  : <threading>multi <webcpp-drive-timeout>60 <library>/webcpp/asio//asio
    <linkflags>-sPTHREAD_POOL_SIZE=1
  : return_probe.mjs ;
webcpp.lane browser-runtime-probes : browser_cobalt_worker_return : emscripten ;

.page-assets = <dependency>../../example/browser/index.html
  <dependency>../../example/browser/workbench.mjs
  <dependency>../../example/browser/workbench.css
  <dependency>../../example/browser/bridge.html ;
webcpp.drive browser_portable : ../../example/applications/portable.cpp
  : <library>/webcpp/cobalt//cobalt <library>/webcpp//node-test
    <webcpp-drive-timeout>180 $(.page-assets)
  : pages.mjs ;
webcpp.drive browser_spsc : ../../example/applications/spsc.cpp
  : <library>/webcpp/cobalt//cobalt <library>/webcpp//node-test
    <threading>multi <linkflags>-sPTHREAD_POOL_SIZE=1 <webcpp-drive-timeout>180 $(.page-assets)
  : pages.mjs ;
webcpp.lane browser-pages : browser_portable : emscripten ;
webcpp.lane browser-worker-pages : browser_spsc : emscripten ;

for local name in http ticker
{
    local requirements = <library>/webcpp/cobalt//cobalt <library>/webcpp/beast//browser
      <linkflags>-sEXIT_RUNTIME=1 ;
    if $(name) = ticker
    {
        requirements += <define>WEBCPP_COBALT_TICKER_COUNTERPART <library>/webcpp//boost_json ;
    }
    obj cobalt-$(name)-network : ../../example/applications/browser_network.cpp
      : $(requirements) ;
    explicit cobalt-$(name)-network ;
    webcpp.variants cobalt-$(name)-ssl : cobalt-$(name)-network
      : $(requirements) ;
    webcpp.drive browser_$(name) : .//cobalt-$(name)-ssl
      : <dependency>cobalt-$(name)-ssl.variants.json <webcpp-drive-timeout>180
        <dependency>../../../beast/test/applications/browser/page.html
        <dependency>../../../beast/test/applications/browser/network-worker.mjs
      : ../../../beast/test/applications/browser/run.mjs
      : --program cobalt-$(name)-ssl --expected "application cobalt-$(name)-ssl: passed" --host both ;
}
webcpp.lane browser-network-counterparts : browser_http browser_ticker : emscripten ;
