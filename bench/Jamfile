# Manual benchmark targets. No CI lane invokes these experiments.
import webcpp ;
webcpp.targets native wasip2 wasip3 emscripten ;

for local library in asio cobalt
{
    local requirements = <library>/webcpp/$(library)//$(library)
      <library>/webcpp/beast//beast
      <toolset>emscripten:<linkflags>-sEXIT_RUNTIME=1
      <toolset>emscripten:<linkflags>-sINCOMING_MODULE_JS_API=arguments,locateFile,print,printErr,onExit,onAbort,onRuntimeInitialized,mainScriptUrlOrBlob ;
    if $(library) = cobalt
    {
        requirements += <define>WEBCPP_BENCH_COBALT
          <toolset>clang,<target-os>darwin,<exception-handling>off:<cxxflags>-Wno-error=coroutine-missing-unhandled-exception ;
    }
    obj $(library)-baseline-object : baseline.cpp : $(requirements) ;
    exe $(library)_baseline : $(library)-baseline-object
      : $(requirements) <exception-handling>off:<source>/webcpp//throw_exception ;
    for local mode in workload memory
    {
        local settings = $(requirements) ;
        if $(mode) = memory { settings += <define>WEBCPP_BENCH_TRACK_CPP_ALLOCATIONS ; }
        obj $(library)-$(mode)-object : workload.cpp : $(settings) ;
        obj $(library)-$(mode)-allocation : allocation.cpp : $(settings) ;
        exe $(library)_$(mode) : $(library)-$(mode)-object $(library)-$(mode)-allocation
          : $(settings) <exception-handling>off:<source>/webcpp//throw_exception ;
        explicit $(library)-$(mode)-object $(library)-$(mode)-allocation $(library)_$(mode) ;
    }
    explicit $(library)-baseline-object $(library)_baseline ;
}
