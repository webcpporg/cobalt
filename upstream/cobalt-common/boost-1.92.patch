+// The POSIX fallback performs the positional syscall during initiation and
+// posts its result. It does not provide kernel-asynchronous disk I/O. Unlike
+// lseek followed by read/write, pread/pwrite never changes the shared cursor.
+template <typename Sequence, typename Operation>
+void positional_io(boost::asio::posix::basic_stream_descriptor<executor> & str,
+                   std::uint64_t offset, Sequence buffers, Operation operation, bool reading,
+                   completion_handler<system::error_code, std::size_t> handler)
+{
+  system::error_code error;
+  std::size_t transferred = 0;
+  visit(buffers, [&](auto sequence)
+  {
+    for (auto it = asio::buffer_sequence_begin(sequence),
+              end = asio::buffer_sequence_end(sequence); it != end; ++it)
+    {
+      const auto buffer = *it;
+      if (buffer.size() == 0)
+        continue;
+      if (offset > static_cast<std::uint64_t>((std::numeric_limits<off_t>::max)()))
+      {
+        error = asio::error::invalid_argument;
+        break;
+      }
+      ssize_t count;
+      do
+      {
+        count = operation(str.native_handle(), buffer.data(),
+                          (std::min)(buffer.size(), static_cast<std::size_t>(
+                              (std::numeric_limits<ssize_t>::max)())),
+                          static_cast<off_t>(offset));
+      }
+      while (count < 0 && errno == EINTR);
+      if (count < 0)
+        error = system::error_code{errno, system::system_category()};
+      else if (count == 0 && reading)
+        error = asio::error::eof;
+      else
+        transferred = static_cast<std::size_t>(count);
+      // read_some/write_some may consume only the first nonempty buffer.
+      break;
+    }
